size(500, 500);
background(#FFFFFF);
strokeWeight(3);

// Pink Lines
stroke(#FF00C0);
line (375, 50, 450, 50);
line (413, 15, 413, 85);
line (390, 25, 435, 75);
line (390, 75, 435, 25);

// Blue Lines
stroke(#00B9FF);
line (50, 50, 125, 50);
line (88, 15, 88, 85);
line (65, 25, 111, 75);
line (65, 75, 111, 25);

//Green Lines 
stroke(#00FF00);
line (210, 440, 285, 440);
line (248, 400, 248, 475);
line (225, 420, 270, 460);
line (225, 460, 270, 420);

strokeWeight(6);
// Yellow Lines
strokeWeight(5);
stroke(#EDFF00);
line (125, 150, 125, 300);
line (125, 150, 200, 75);
line (200, 75, 325, 75);
line (325, 75, 400, 150);
line (400, 150, 350, 200);
line (350, 200, 300, 150);
line (300, 150, 225, 225);
line (225, 225, 300, 300);
line (125, 300, 200, 375);
line (200, 375, 325, 375);
line (325, 375, 400, 300);
line (400, 300, 350, 250);
line (350, 250, 300, 300);
